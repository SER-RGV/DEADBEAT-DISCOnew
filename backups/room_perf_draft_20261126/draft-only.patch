@@ -29,3 +29,29 @@ function playableRoom(node) {
   playableCache.set(node, compiled);
   return compiled;
 }
+
+// Experimental generation-only draft: physical geometry needed by population
+// safety checks, not a render mesh. Compiled room is still built on entry.
+function populationRoomDraft(node) {
+  if (node.floor === 0 && node.key === 'r0') return null;
+  const spec = prefabCatalog.templates[node.prefab.template], loop=spec.perimeter;
+  const edges=loop.map(([id,x,y],i)=>{
+    const [,u,v]=loop[(i+1)%loop.length],dx=u-x,dy=v-y,len=Math.hypot(dx,dy);
+    return {id,a:{x,y},dx,dy,len,nx:-dy/len,ny:dx/len};
+  });
+  const edge=id=>{const e=edges.find(e=>e.id===id);if(!e)throw Error('missing anchor '+id);return e;};
+  const point=(e,t,inset)=>({x:e.a.x+t*e.dx+e.nx*inset,y:e.a.y+t*e.dy+e.ny*inset});
+  const openings=node.prefab.connections.map(d=>{
+    const e=edge(spec.sockets[d.side]),p=point(e,0.5,0),tx=e.dx/e.len,ty=e.dy/e.len;
+    const u=(p.x-e.a.x)*tx+(p.y-e.a.y)*ty;
+    return {origin:{x:e.a.x+tx*u+e.nx*0,y:e.a.y+ty*u+e.ny*0},useRadius:137};
+  });
+  const cardinal=[[0,1,'S'],[-1,0,'W'],[0,-1,'N'],[1,0,'E']];
+  const placements=spec.placements.filter(p=>prefabCatalog.assets[p.asset].solid).map(p=>{
+    const e=edge(p.edge),asset=prefabCatalog.assets[p.asset],front=p.facing==='inward'?cardinal.find(([x,y])=>x===e.nx&&y===e.ny):cardinal.find(v=>v[2]===p.facing);
+    if(!front)throw Error('mount needs an authored cardinal view: '+p.id);
+    return {anchor:point(e,p.t,p.inset),collider:{...asset.footprint,angle:(cardinal.indexOf(front)*Math.PI)/2},solid:asset.solid};
+  });
+  const w=Math.max(...loop.map(v=>v[1])),h=Math.max(...loop.map(v=>v[2]));
+  return {mesh:{openings,placements},geometry:{...node.geometry,w,h,pts:loop.map(([,x,y])=>[x/w,y/h]),center:[.5,.5]}};
+}
